# Normaliza fim de linha independente do core.autocrlf de cada máquina.
# Sem isto, um commit feito no Windows pode gravar CRLF e quebrar o
# build da imagem (Docker) ou os scripts do CI ao rodar em Linux.
* text=auto eol=lf

# Arquivos que precisam de LF mesmo se alguém mudar a regra acima.
Dockerfile     text eol=lf
*.sh           text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.conf         text eol=lf
*.sql          text eol=lf

# Binários — nunca converter.
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.woff         binary
*.woff2        binary
*.pdf          binary
