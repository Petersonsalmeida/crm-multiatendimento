# === Supabase ===
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxx
SUPABASE_SERVICE_KEY=eyJxxxx
SUPABASE_JWT_SECRET=your-jwt-secret

# === Evolution API (já rodando no VPS) ===
EVOLUTION_API_URL=https://evo.centroautoalianca.com.br
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=alianca
# Segredo compartilhado: quando setado, /webhooks/evolution exige
# header `apikey` igual a este valor. Vazio = aceita qualquer chamada (dev).
# OBRIGATÓRIO quando NODE_ENV=production — o backend se recusa a subir sem ele.
EVOLUTION_WEBHOOK_SECRET=

# === Claude API ===
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-sonnet-4-5

# === N8N ===
N8N_WEBHOOK_URL=https://n8n.centroautoalianca.com.br/webhook/followup

# === Backend ===
PORT=3001
NODE_ENV=development
JWT_SECRET=change-this-in-production
LOG_LEVEL=info
# Allowlist de origens do frontend, separadas por vírgula.
# Vazio (dev) = libera apenas localhost. OBRIGATÓRIO em produção.
CORS_ORIGINS=

# === Frontend (prefixo VITE_ obrigatório) ===
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxx
