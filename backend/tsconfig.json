{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],

    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],

  // `tsc` não reescreve os aliases `@/*` no JS emitido e o Node não sabe
  // resolvê-los em runtime — sem este passo, `node dist/server.js` morre
  // com ERR_MODULE_NOT_FOUND. `resolveFullPaths` também acrescenta a
  // extensão `.js`, exigida por ESM no Node.
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
